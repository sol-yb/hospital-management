<%- include('../partials/header', { title: 'Register - Hospital Management' }) %>
  <section class="auth-shell">
    <div class="auth-card">
      <div class="auth-head">
        <span>Create an account</span>
        <h1>Register</h1>
      </div>
      <div class="form-message"></div>
      <form method="post" action="/api/auth/register" data-validate>
        <div class="form-field">
          <label for="name">Name</label>
          <input id="name" name="name" required placeholder="Full name" />
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" required placeholder="you@example.com" />
        </div>
        <div class="form-field">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required placeholder="Create a strong password" />
        </div>
        <button type="submit">Register</button>
      </form>
    </div>
  </section>
<%- include('../partials/footer') %>
